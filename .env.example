# Google AI Studio (aistudio.google.com) -> Get API key
GEMINI_API_KEY=

# Your private Gmail address (the "Alken" mailbox) and its 16-letter app password
# Not used while MAIL_MODE=folder; kept ready for when real Gmail is wired up.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Who receives the internal notifications (can be the same Gmail address)
REVIEWER_EMAIL=

# The address that plays the investor in the demo
DEMO_INVESTOR_EMAIL=

# Only emails with this Gmail label are read by the agent (real-Gmail mode only)
GMAIL_LABEL=

# Mailbox mode: 'folder' = simulated mailbox in mailbox/ (no real email sent)
MAIL_MODE=folder
